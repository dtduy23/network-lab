[Unit]
Description=Network lab system health snapshot
After=network-online.target
OnFailure=lab-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/healthcheck.py
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/network-lab /var/lib/network-lab
