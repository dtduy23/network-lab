# Managed policy inside the router guest. Never load this on the host.
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate INVALID -j DROP
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -i {{ mgmt_iface }} -p tcp --dport 22 -j ACCEPT
-A INPUT -i {{ mgmt_iface }} -p udp --sport 67 --dport 68 -j ACCEPT
-A INPUT -i lan0 -p udp --sport 68 --dport 67 -j ACCEPT
-A INPUT -i lan0 -s {{ lab_lan_cidr }} -p icmp -j ACCEPT
-A INPUT -i dmz0 -s {{ lab_dmz_cidr }} -p icmp -j ACCEPT
-A INPUT -m limit --limit 3/min --limit-burst 5 -j LOG --log-prefix "LAB INPUT DROP "
-A FORWARD -m conntrack --ctstate INVALID -j DROP
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
# LAN -> DMZ: DNS and web only; SSH and database are deliberately absent.
-A FORWARD -i lan0 -o dmz0 -s {{ lab_lan_cidr }} -d {{ lab_server_ip }} -p udp --dport 53 -j ACCEPT
-A FORWARD -i lan0 -o dmz0 -s {{ lab_lan_cidr }} -d {{ lab_server_ip }} -p tcp -m multiport --dports 53,80,443 -j ACCEPT
-A FORWARD -i lan0 -o dmz0 -s {{ lab_lan_cidr }} -d {{ lab_server_ip }} -p icmp -j ACCEPT
# External DNS is reachable only from the DMZ DNS server, to chosen forwarders.
{% for address in lab_forwarders %}
-A FORWARD -i dmz0 -o {{ mgmt_iface }} -s {{ lab_server_ip }} -d {{ address }} -p udp --dport 53 -j ACCEPT
-A FORWARD -i dmz0 -o {{ mgmt_iface }} -s {{ lab_server_ip }} -d {{ address }} -p tcp --dport 53 -j ACCEPT
{% endfor %}
{% for segment in ['lan', 'dmz'] %}
-A FORWARD -i {{ segment }}0 -o {{ mgmt_iface }} -s {{ lab_lan_cidr if segment == 'lan' else lab_dmz_cidr }} -p tcp -m multiport --dports 80,443 -j ACCEPT
-A FORWARD -i {{ segment }}0 -o {{ mgmt_iface }} -s {{ lab_lan_cidr if segment == 'lan' else lab_dmz_cidr }} -p udp --dport 123 -j ACCEPT
-A FORWARD -i {{ segment }}0 -o {{ mgmt_iface }} -s {{ lab_lan_cidr if segment == 'lan' else lab_dmz_cidr }} -p icmp -j ACCEPT
{% endfor %}
# DNAT from the WAN/management NIC. Vagrant exposes it on host localhost:8080.
-A FORWARD -i {{ mgmt_iface }} -o dmz0 -d {{ lab_server_ip }} -p tcp --dport 80 -m conntrack --ctstate DNAT -j ACCEPT
-A FORWARD -m limit --limit 3/min --limit-burst 5 -j LOG --log-prefix "LAB FORWARD DROP "
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -i {{ mgmt_iface }} -p tcp --dport 8080 -j DNAT --to-destination {{ lab_server_ip }}:80
# Return forwarded web traffic through router even when WAN source overlaps
# the server's management subnet (VirtualBox/QEMU NAT uses 10.0.2.0/24).
-A POSTROUTING -o dmz0 -d {{ lab_server_ip }} -p tcp --dport 80 -m conntrack --ctstate DNAT -j SNAT --to-source {{ lab_router_dmz }}
-A POSTROUTING -s {{ lab_lan_cidr }} -o {{ mgmt_iface }} -j MASQUERADE
-A POSTROUTING -s {{ lab_dmz_cidr }} -o {{ mgmt_iface }} -j MASQUERADE
COMMIT
