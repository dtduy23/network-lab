[Unit]
Description=Network lab LAN DHCP service
Wants=network-online.target
After=network-online.target lab-firewall.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/dnsmasq.d/network-lab.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
